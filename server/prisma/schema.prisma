generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum FlagStatus {
  NEW
  RESOLVED
}

enum AttemptMode {
  TIMED
  PRACTICE
  TEST
}

enum DeviceType {
  DESKTOP
  MOBILE
}

model University {
  id        String    @id @default(cuid())
  name      String    @unique
  shortName String?
  createdAt DateTime  @default(now())
  programs  Program[]
}

model Program {
  id           String       @id @default(cuid())
  universityId String
  code         String?
  name         String
  school       String?
  order        Int          @default(0)
  createdAt    DateTime     @default(now())

  university University     @relation(fields: [universityId], references: [id], onDelete: Cascade)
  exams      Exam[]
  students   User[]
  notifications Notification[]

  @@index([universityId])
}

// Бүртгэлийн салбар сургууль / хөтөлбөр — шалгалтын Program-аас тусдаа
model AcademicProgram {
  id         String   @id @default(cuid())
  university String   // жишээ: МУИС
  school     String   // жишээ: МТЭС, ХУС, ИТС
  name       String   // жишээ: Нягтлан бодох, Программ хангамж
  code       String?  // жишээ: ACC101
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  students User[] @relation("AcademicProgramStudents")

  @@unique([university, school, name])
  @@index([school])
  @@index([university])
}

model Exam {
  id        String   @id @default(cuid())
  programId String
  code      String   @unique
  title     String
  source    String?
  year      Int
  variant   String?
  durationMin Int?
  order     Int      @default(0)
  isFree    Boolean  @default(false)
  createdAt DateTime @default(now())

  program  Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts TestAttempt[]
  planExams PlanExam[]

  @@index([programId])
  @@index([year])
}

model Question {
  id           String   @id @default(cuid())
  examId       String
  order        Int      @default(0)
  type         String   @default("open")
  topic        String?
  level        String?
  year         Int?
  source       String?
  prompt       String
  modelSolution String?
  answer       String?
  // TEST төрөл: сонголтууд (текст+түлхүүр) ба зөв хариултын түлхүүр салдаг хадгалагдана.
  // correctChoice нь оюутанд тест дуустал API-ээр огт илгээгдэхгүй.
  choices       Json?    // [{ key: "A", text: "..." }, ...] — яг 4 элемент
  correctChoice String?  // "A" | "B" | "C" | "D"
  points       Float    @default(1)
  needsReview  Boolean  @default(false)
  tags         String[] @default([])
  createdAt    DateTime @default(now())

  exam        Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  flags       Flag[]
  bookmarks   Bookmark[]
  attemptAnswers AttemptAnswer[]

  @@index([examId])
  @@index([topic])
  @@index([level])
  @@index([year])
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String   @unique
  otp       String
  expires   DateTime
  createdAt DateTime @default(now())
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  phone               String?
  role                Role      @default(STUDENT)
  programId           String?
  academicProgramId   String?
  isVerified          Boolean   @default(false)
  verifyOtp           String?
  verifyExpires       DateTime?
  createdAt           DateTime  @default(now())

  program             Program?         @relation(fields: [programId], references: [id], onDelete: SetNull)
  academicProgram     AcademicProgram? @relation("AcademicProgramStudents", fields: [academicProgramId], references: [id], onDelete: SetNull)
  flags         Flag[]
  bookmarks     Bookmark[]
  attempts      TestAttempt[]
  notifications Notification[]
  payments      PaymentTransaction[]
  sessions      UserSession[]
  pushSubscriptions PushSubscription[]
  usageMinutes UsageMinute[]
  chatProfile ChatProfile?
  chatMessages ChatMessage[]
  chatMemberships ChatMember[]
  chatSentInvites ChatInvite[] @relation("ChatInviter")
  chatReceivedInvites ChatInvite[] @relation("ChatInvitee")
  chatBlocks ChatBlock[] @relation("ChatBlocker")
  chatBlockedBy ChatBlock[] @relation("ChatBlocked")
  chatSaved ChatSavedMessage[]
  chatHearts ChatHeart[]
  chatReports ChatReport[]

  @@index([role])
}

model Flag {
  id         String     @id @default(cuid())
  questionId String
  userId     String
  reason     String
  status     FlagStatus @default(NEW)
  adminNote  String?
  createdAt  DateTime   @default(now())
  resolvedAt DateTime?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([questionId])
}

model Bookmark {
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
}

model TestAttempt {
  id          String      @id @default(cuid())
  userId      String
  examId      String
  mode        AttemptMode @default(PRACTICE)
  format      String      @default("OPEN")  // OPEN | TEST
  score       Float       @default(0)
  totalPoints Float       @default(0)
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam    Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@index([userId])
  @@index([examId])
}

model AttemptAnswer {
  id           String  @id @default(cuid())
  attemptId    String
  questionId   String
  givenAnswer  String?
  pointsEarned Float   @default(0)
  isCorrect    Boolean @default(false)
  feedback     String?
  gradedBy     String?

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  body        String
  programId   String?
  createdById String
  createdAt   DateTime @default(now())

  program   Program? @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Plan {
  id           String  @id @default(cuid())
  code         String  @unique
  title        String
  description  String?
  priceMnt     Int
  durationDays Int     @default(30) // 30 хоногийн эрх
  active       Boolean @default(true)
  createdAt    DateTime @default(now())

  exams        PlanExam[]
  transactions PaymentTransaction[]
}

model PlanExam {
  planId String
  examId String

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@id([planId, examId])
}

model PaymentTransaction {
  id            String    @id @default(cuid())
  userId        String
  planId        String?
  transactionId String    @unique
  invoiceId     String?
  amount        Int
  status        String    @default("PENDING")
  provider      String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  expiresAt     DateTime? // 30 хоногийн дараа дуусна

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
}

// Web Push subscription — 1 user олон төхөөрөмжтэй байж болно (endpoint unique).
// System notification (түгжээтэй утсан дээр ч) илгээхэд ашиглана.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Админы удирддаг сайтын тохиргоо (key-value) — жишээ: landing цаг агаарын theme.
// Render startup дээр `prisma db push`-ээр автоматаар үүснэ.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// 1 account = 1 DESKTOP + 1 MOBILE зэрэг — userId+deviceType unique.
// Шинэ төхөөрөмж нэвтрэхэд хуучин session устгагдаж, хуучин jti-тэй token 401 болно.
model UserSession {
  id         String     @id @default(cuid())
  userId     String
  deviceType DeviceType
  jti        String     @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime   @default(now())
  lastActive DateTime   @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceType])
  @@index([userId])
  @@index([expiresAt])
}

model UsageMinute {
  userId      String
  minuteAt    DateTime
  secondsMask BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, minuteAt])
  @@index([minuteAt])
}

model ChatProfile {
  userId String @id
  hasVisited Boolean @default(false)
  selectedBadge String?
  badgeColor String @default("orange")
  allowInvites Boolean @default(true)
  muted Boolean @default(false)
  timeoutUntil DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatRoom {
  id String @id @default(cuid())
  kind String @default("DIRECT")
  pairKey String? @unique
  createdAt DateTime @default(now())
  pinnedMessageId String? @unique
  pinnedMessage ChatMessage? @relation("ChatPinnedMessage", fields: [pinnedMessageId], references: [id], onDelete: SetNull)
  messages ChatMessage[]
  members ChatMember[]
  invite ChatInvite?
}

model ChatMember {
  roomId String
  userId String
  readAt DateTime @default(now())
  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id String @id @default(cuid())
  roomId String
  userId String
  clientId String
  body String
  mentions Json @default("[]")
  system Json?
  replyToId String?
  replyTo ChatMessage? @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies ChatMessage[] @relation("ChatReplies")
  createdAt DateTime @default(now())
  deletedAt DateTime?
  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  saved ChatSavedMessage[]
  hearts ChatHeart[]
  reports ChatReport[]
  pinnedInRoom ChatRoom? @relation("ChatPinnedMessage")
  @@unique([userId, clientId])
  @@index([roomId, createdAt, id])
  @@index([replyToId])
}

model ChatHeart {
  userId String
  messageId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  @@id([userId, messageId])
  @@index([messageId])
}

model ChatInvite {
  id String @id @default(cuid())
  senderId String
  recipientId String
  pairKey String @unique
  status String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roomId String? @unique
  sender User @relation("ChatInviter", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ChatInvitee", fields: [recipientId], references: [id], onDelete: Cascade)
  room ChatRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  @@index([recipientId, status])
  @@index([senderId, createdAt])
}

model ChatBlock {
  userId String
  blockedId String
  createdAt DateTime @default(now())
  user User @relation("ChatBlocker", fields: [userId], references: [id], onDelete: Cascade)
  blocked User @relation("ChatBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@id([userId, blockedId])
  @@index([blockedId])
}

model ChatSavedMessage {
  userId String
  messageId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  @@id([userId, messageId])
}

model ChatReport {
  id String @id @default(cuid())
  userId String
  messageId String
  reason String
  resolved Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  @@unique([userId, messageId])
  @@index([resolved, createdAt])
}
