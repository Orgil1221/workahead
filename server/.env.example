DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workahead?schema=public"
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
CSRF_SECRET="change-me-to-another-random-secret-at-least-32-chars"
OTP_HASH_SECRET="change-me-to-a-third-random-secret-at-least-32-chars"
REDIS_URL="redis://localhost:6379"
PORT=4000
CORS_ORIGIN="http://localhost:5173,http://localhost:80"
# Production: "https://workahead.me,https://www.workahead.me"
PUBLIC_BASE_URL="http://localhost:5173"
# Production: "https://workahead.me"
# Rate limit-ийг түр унтраах бол 1 болгоно (production дээр заавал устгаж / 0 болгоно — зөвхөн dev-д ажиллана)
RATE_LIMIT_DISABLED="0"
# Bonum — test: https://testapi.bonum.mn, prod: https://apis.bonum.mn (s-тай, doc дагуу)
BONUM_API_BASE_URL="https://testapi.bonum.mn"
BONUM_APP_SECRET=""
BONUM_TERMINAL_ID=""
BONUM_CHECKSUM_KEY=""
# Invoice item logo — bank app (QPAY) shows this next to "Work Ahead".
# Default: {PUBLIC_BASE_URL}/icon-192.png (prod https://workahead.me/icon-192.png).
# Override only if you upload a dedicated merchant logo (absolute https PNG/JPG, <200KB).
# BONUM_INVOICE_IMAGE_URL="https://workahead.me/icon-192.png"
# Төлбөрийн өдрийн лимит — Bonum мерчант шаардлага, env-ээр дарж болно
BONUM_DAILY_MAX_COUNT="200"
BONUM_DAILY_MAX_AMOUNT="1399800"
# Mock төлбөр — dev/test-д Бонум алдагдсан үед авто PAID болгох; prod-д заавал 0
ALLOW_MOCK_PAYMENTS="0"
# Pending гүйлгээ хэдэн минутад FAILED болох (DoS-аас сэргийлнэ)
PENDING_TTL_MINUTES="15"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
# Web Push (VAPID) — систем notification (түгжээтэй утсан дээр ч) илгээхэд
# Түлхүүр гаргах: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@workahead.me"
# Business mail OTP — failover: Resend → Brevo → SMTP → console (дараалал: EMAIL_PROVIDER_ORDER)
# Quota дүүрсэн/алдаатай provider-ийг cooldown хугацаанд алгасаж, дараагийнх руу шилжинэ.
# RESEND_API_KEY="re_xxx" # Resend.com API key
# BREVO_API_KEY="xkeysib-xxx" # Brevo.com (v3 API) key — Resend quota дүүрсэн үед ажиллана
# EMAIL_PROVIDER_ORDER="resend,brevo,smtp" # эсвэл "brevo,resend,smtp"
# EMAIL_QUOTA_COOLDOWN_MIN="30"     # quota алдсаны дараах эхний cooldown (дараагийн алдаа бүрд 2 дахин)
# EMAIL_QUOTA_COOLDOWN_MAX_MIN="360" # quota cooldown-ийн дээд хязгаар
# EMAIL_FAIL_COOLDOWN_SEC="90"      # бусад алдаа (401, сүлжээ) — хэдэн секунд өнжих
# EMAIL_FROM="noreply@workahead.me"
# BUSINESS_MAIL="info@workahead.me"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="noreply@workahead.me"
# SMTP_PASS="app-password"
# SMTP_SECURE="false"
